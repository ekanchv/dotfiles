# Versions for tools installed from upstream releases (everything else comes from apt).
# Each can be an exact version or "latest" (resolved at install time). PYTHON_VERSION
# also takes a prefix like "3.13" for the newest 3.13.x. Re-run install.sh to apply.

CHEZMOI_VERSION="2.70.5"
PYENV_VERSION="2.7.3"
PYTHON_VERSION="3.13.7"
NEOVIM_VERSION="0.12.4" # apt's 0.9 is too old for the config

# Needed by the neovim config (mason servers, treesitter, markdown-preview, quarto)
NODE_VERSION="26.4.0"
GO_VERSION="1.26.4"
TREE_SITTER_VERSION="0.25.10" # nvim-treesitter main needs >= 0.25; apt has 0.20
QUARTO_VERSION="1.9.38"

BAZELISK_VERSION="1.29.0" # installed as `bazel`; repos pick bazel itself via .bazelversion
# Not pinned: cmake tracks Kitware's apt repo, brew self-updates, rust/lean use their stable channels.

# Rocq via opam, in opam's global switch "default" (apt's coq is 8.18; Iris needs Rocq 9).
# Same versions as github.com/logsem/iris-tutorial. IRIS_VERSION="" skips Iris.
OCAML_VERSION="5.4.0"
ROCQ_VERSION="9.2.0" # also pins coqide-server, which provides Coqtail's coqidetop
IRIS_VERSION="4.5.0"

# GUI
GHOSTTY_DEB_TAG="1.3.1-0-ppa2" # release tag in github.com/mkasberg/ghostty-ubuntu
NERD_FONT="JetBrainsMono"
